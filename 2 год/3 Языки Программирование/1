using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using CSConsoleApp.Models;
using CSConsoleApp.Services;
using CSConsoleApp.Utils;
using CSConsoleApp.Domain;

namespace CSConsoleApp
{
    public static class Program
    {
        public static void Main(string[] args)
        {
            Console.OutputEncoding = Encoding.UTF8;
            var path = args.Length > 0 ? args[0] : "tmdb_5000_credits.csv";
            if (!File.Exists(path))
            {
                Console.Error.WriteLine($"Файл не найден: {path}. Положите tmdb_5000_credits.csv рядом с exe или передайте путь аргументом.");
                return;
            }

            Console.WriteLine($"Загружаю: {Path.GetFullPath(path)}\n");
            var movies = CreditsLoader.LoadCredits(path);
            Console.WriteLine($"Загружено фильмов: {movies.Count}\n");

            var idToName = Helpers.BuildIdToName(movies);
            QueryRunner.RunAll(movies, idToName);

            Console.WriteLine("Готово.");
        }
    }
}

