using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using CSConsoleApp.Models;

namespace CSConsoleApp.Utils
{
    public static class Helpers
    {
        public static string FirstWord(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return s;
            s = s.Trim();
            var sb = new StringBuilder();
            foreach (var ch in s)
            {
                if (char.IsLetterOrDigit(ch)) sb.Append(ch);
                else break;
            }
            return sb.ToString();
        }

        public static bool EqualsName(string? a, string b) => string.Equals(a?.Trim(), b, StringComparison.OrdinalIgnoreCase);
        public static bool EqualsJob(string? a, string b) => string.Equals(a?.Trim(), b, StringComparison.OrdinalIgnoreCase);
        public static bool EqualsDepartment(string? a, string b) => string.Equals(a?.Trim(), b, StringComparison.OrdinalIgnoreCase);

        public static Dictionary<int, string> BuildIdToName(List<MovieCredits> movies)
        {
            var dict = new Dictionary<int, string>();
            foreach (var c in movies.SelectMany(m => m.Cast)) dict[c.Id] = c.Name;
            foreach (var c in movies.SelectMany(m => m.Crew)) dict[c.Id] = c.Name;
            return dict;
        }

        public static string NameOf(Dictionary<int, string> idToName, int id) => idToName.TryGetValue(id, out var n) ? n : $"#{id}";
    }
}

