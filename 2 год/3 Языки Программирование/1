using System;
using System.Collections.Generic;
using System.Linq;
using CSConsoleApp.Models;
using CSConsoleApp.Utils;

namespace CSConsoleApp.Domain
{
    public static class QueryRunner
    {
        public static void RunAll(List<MovieCredits> movies, Dictionary<int, string> idToName)
        {
            // 1. Фильмы, снятые режиссером "Steven Spielberg".
            Printer.Section("Фильмы режиссёра Steven Spielberg");
            var spielbergMovies = movies.Where(m => m.Crew.Any(c => Helpers.EqualsName(c.Name, "Steven Spielberg") && Helpers.EqualsJob(c.Job, "Director")))
                                        .Select(m => m.Title)
                                        .OrderBy(t => t)
                                        .ToList();
            Printer.DumpList(spielbergMovies);

            // 2. Персонажи Тома Хэнкса
            Printer.Section("Персонажи актёра Tom Hanks");
            var hanksRoles = movies.SelectMany(m => m.Cast.Where(c => Helpers.EqualsName(c.Name, "Tom Hanks")))
                                   .Select(c => c.Character ?? "?")
                                   .Where(s => !string.IsNullOrWhiteSpace(s))
                                   .Select(s => s.Trim())
                                   .Distinct()
                                   .OrderBy(s => s)
                                   .ToList();
            Printer.DumpList(hanksRoles);

            // 3. Топ-5 фильмов с самым большим количеством актёров
            Printer.Section("5 фильмов с самым большим количеством актёров");
            var biggestCasts = movies.Select(m => (m.Title, CastCount: m.Cast.Count))
                                     .OrderByDescending(t => t.CastCount)
                                     .ThenBy(t => t.Title)
                                     .Take(5)
                                     .ToList();
            foreach (var (title, count) in biggestCasts) Console.WriteLine($"{title} — Cast: {count}");
            Console.WriteLine();

            // 4. Топ-10 самых востребованных актёров
            Printer.Section("Топ-10 самых востребованных актёров (по количеству фильмов)");
            var actorMovieCounts = movies.SelectMany(m => m.Cast.Select(c => (ActorId: c.Id, c.Name, m.MovieId)))
                                         .GroupBy(x => x.ActorId)
                                         .Select(g => new { Id = g.Key, Name = g.Select(x => x.Name).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? $"#{g.Key}", Cnt = g.Select(x => x.MovieId).Distinct().Count() })
                                         .OrderByDescending(x => x.Cnt)
                                         .ThenBy(x => x.Name)
                                         .Take(10)
                                         .ToList();
            foreach (var a in actorMovieCounts) Console.WriteLine($"{a.Name} — фильмов: {a.Cnt}");
            Console.WriteLine();

            // 5. Уникальные департаменты
            Printer.Section("Уникальные департаменты (Crew.Department)");
            var departments = movies.SelectMany(m => m.Crew)
                                    .Select(c => c.Department)
                                    .Where(s => !string.IsNullOrWhiteSpace(s))
                                    .Select(s => s.Trim())
                                    .Distinct()
                                    .OrderBy(s => s)
                                    .ToList();
            Printer.DumpList(departments);

            // 6. Hans Zimmer — Original Music Composer
            Printer.Section("Фильмы, где Hans Zimmer — Original Music Composer");
            var zimmerMovies = movies.Where(m => m.Crew.Any(c => Helpers.EqualsName(c.Name, "Hans Zimmer") && Helpers.EqualsJob(c.Job, "Original Music Composer")))
                                     .Select(m => m.Title)
                                     .OrderBy(t => t)
                                     .ToList();
            Printer.DumpList(zimmerMovies);

            // 7. Словарь: movieId -> режиссёр(ы)
            Printer.Section("Словарь: MovieID → режиссёр(ы)");
            var movieToDirectors = movies.ToDictionary(m => m.MovieId, m => string.Join(", ", m.Crew.Where(c => Helpers.EqualsJob(c.Job, "Director")).Select(c => c.Name).Distinct()));
            Console.WriteLine($"Всего записей: {movieToDirectors.Count}");
            foreach (var kv in movieToDirectors.Take(10)) Console.WriteLine($"{kv.Key} → {kv.Value}");
            Console.WriteLine();

            // 8. Фильмы с Brad Pitt и George Clooney
            Printer.Section("Фильмы с Brad Pitt и George Clooney");
            var pittClooney = movies.Where(m => m.Cast.Any(c => Helpers.EqualsName(c.Name, "Brad Pitt")) && m.Cast.Any(c => Helpers.EqualsName(c.Name, "George Clooney")))
                                    .Select(m => m.Title)
                                    .OrderBy(t => t)
                                    .ToList();
            Printer.DumpList(pittClooney);

            // 9. Сколько человек в департаменте "Camera"
            Printer.Section("Суммарно людей в департаменте Camera (вхождений) и уникальных персон");
            var cameraAll = movies.SelectMany(m => m.Crew.Where(c => Helpers.EqualsDepartment(c.Department, "Camera"))).ToList();
            var cameraTotalEntries = cameraAll.Count;
            var cameraUniquePeople = cameraAll.Select(c => c.Id).Distinct().Count();
            Console.WriteLine($"Всего вхождений: {cameraTotalEntries}");
            Console.WriteLine($"Уникальных людей: {cameraUniquePeople}\n");

            // 10. Люди, одновременно в Cast и Crew фильма Titanic
            Printer.Section("Люди, одновременно в Cast и Crew фильма Titanic");
            var titanic = movies.FirstOrDefault(m => string.Equals(m.Title, "Titanic", StringComparison.OrdinalIgnoreCase));
            if (titanic != null)
            {
                var castIds = titanic.Cast.Select(c => c.Id).ToHashSet();
                var crewIds = titanic.Crew.Select(c => c.Id).ToHashSet();
                var both = castIds.Intersect(crewIds).ToList();
                var names = both.Select(id => idToName.TryGetValue(id, out var n) ? n : $"#{id}").OrderBy(n => n).ToList();
                Printer.DumpList(names);
            }
            else Console.WriteLine("Titanic не найден\n");

            // 11. Топ-5 членов съёмочной группы с Тарантино
            Printer.Section("Топ-5 членов съёмочной группы, чаще всего работавших с режиссёром Quentin Tarantino");
            var tarantinoMovies = movies.Where(m => m.Crew.Any(c => Helpers.EqualsName(c.Name, "Quentin Tarantino") && Helpers.EqualsJob(c.Job, "Director"))).ToList();
            var tarantinoCrewCounts = tarantinoMovies
                .SelectMany(m => m.Crew)
                .Where(c => !Helpers.EqualsName(c.Name, "Quentin Tarantino"))
                .GroupBy(c => c.Id)
                .Select(g => new { Id = g.Key, Name = g.Select(x => x.Name).FirstOrDefault() ?? $"#{g.Key}", Films = g.Select(x => x.CreditId + "@" + x.Name).Distinct().Count() })
                .OrderByDescending(x => x.Films)
                .ThenBy(x => x.Name)
                .Take(5)
                .ToList();
            foreach (var p in tarantinoCrewCounts) Console.WriteLine($"{p.Name} — фильмов: {p.Films}");
            Console.WriteLine();

            // 12. Экранные дуэты
            Printer.Section("Топ-10 экранных дуэтов (пары актёров по количеству совместных фильмов)");
            var pairCounts = new Dictionary<(int, int), int>();
            foreach (var m in movies)
            {
                var ids = m.Cast.Select(c => c.Id).Distinct().ToList();
                ids.Sort();
                for (int i = 0; i < ids.Count; i++)
                for (int j = i + 1; j < ids.Count; j++)
                {
                    var key = (ids[i], ids[j]);
                    pairCounts.TryGetValue(key, out var cnt);
                    pairCounts[key] = cnt + 1;
                }
            }
            var topPairs = pairCounts.OrderByDescending(kv => kv.Value)
                                     .ThenBy(kv => Helpers.NameOf(idToName, kv.Key.Item1) + " & " + Helpers.NameOf(idToName, kv.Key.Item2))
                                     .Take(10)
                                     .ToList();
            foreach (var kv in topPairs)
            {
                var (a, b) = kv.Key;
                Console.WriteLine($"{Helpers.NameOf(idToName, a)} & {Helpers.NameOf(idToName, b)} — фильмов вместе: {kv.Value}");
            }
            Console.WriteLine();

            // 13. Индекс разнообразия
            Printer.Section("Топ-5 по разнообразию департаментов (Crew)");
            var diversity = movies.SelectMany(m => m.Crew)
                                  .GroupBy(c => c.Id)
                                  .Select(g => new { Id = g.Key, Name = g.Select(x => x.Name).FirstOrDefault() ?? $"#{g.Key}", DeptCount = g.Select(x => x.Department).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim()).Distinct().Count() })
                                  .OrderByDescending(x => x.DeptCount)
                                  .ThenBy(x => x.Name)
                                  .Take(5)
                                  .ToList();
            foreach (var x in diversity) Console.WriteLine($"{x.Name} — департаментов: {x.DeptCount}");
            Console.WriteLine();

            // 14. Творческие трио
            Printer.Section("Творческие трио (один человек: Director + Writer + Producer в одном фильме)");
            var writerJobs = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Writer", "Screenplay" };
            var producerJobs = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Producer" };
            var creativeTrios = new List<string>();
            foreach (var m in movies)
            {
                var perPersonJobs = m.Crew.GroupBy(c => c.Id)
                    .ToDictionary(g => g.Key, g => g.Select(x => x.Job).Where(s => !string.IsNullOrWhiteSpace(s)).ToHashSet(StringComparer.OrdinalIgnoreCase));
                foreach (var kv in perPersonJobs)
                {
                    var jobs = kv.Value;
                    if (jobs.Contains("Director") && jobs.Any(j => writerJobs.Contains(j)) && jobs.Any(j => producerJobs.Contains(j)))
                    {
                        var name = idToName.TryGetValue(kv.Key, out var n) ? n : $"#{kv.Key}";
                        creativeTrios.Add($"{m.Title} — {name}");
                    }
                }
            }
            creativeTrios = creativeTrios.Distinct().OrderBy(s => s).ToList();
            Printer.DumpList(creativeTrios);

            // 15. Два шага до Kevin Bacon
            Printer.Section("Актёры в двух шагах от Kevin Bacon (исключая тех, кто снимался с ним напрямую)");
            var baconIdSet = movies.SelectMany(m => m.Cast.Where(c => Helpers.EqualsName(c.Name, "Kevin Bacon")).Select(c => c.Id)).ToHashSet();
            if (baconIdSet.Count == 0)
            {
                Console.WriteLine("Kevin Bacon не найден в датасете.\n");
            }
            else
            {
                var coStars1 = movies.Where(m => m.Cast.Any(c => baconIdSet.Contains(c.Id)))
                                      .SelectMany(m => m.Cast.Select(c => c.Id))
                                      .Where(id => !baconIdSet.Contains(id))
                                      .ToHashSet();
                var coStars2 = movies.Where(m => m.Cast.Any(c => coStars1.Contains(c.Id)))
                                      .SelectMany(m => m.Cast.Select(c => c.Id))
                                      .Where(id => !baconIdSet.Contains(id))
                                      .ToHashSet();
                coStars2.ExceptWith(coStars1);
                var names2 = coStars2.Select(id => Helpers.NameOf(idToName, id)).OrderBy(n => n).ToList();
                Printer.DumpList(names2);
            }

            // 16. Командная работа: средний Cast/Crew по режиссёрам
            Printer.Section("Средний размер Cast/Crew по режиссёрам");
            var dirToFilms = new Dictionary<string, List<MovieCredits>>(StringComparer.OrdinalIgnoreCase);
            foreach (var m in movies)
            {
                var dirs = m.Crew.Where(c => Helpers.EqualsJob(c.Job, "Director")).Select(c => c.Name).Distinct();
                foreach (var d in dirs)
                {
                    if (!dirToFilms.TryGetValue(d, out var list)) dirToFilms[d] = list = new List<MovieCredits>();
                    list.Add(m);
                }
            }
            var perDirector = dirToFilms.Select(kv => new
            {
                Director = kv.Key,
                Films = kv.Value.Count,
                AvgCast = kv.Value.Average(m => m.Cast.Count),
                AvgCrew = kv.Value.Average(m => m.Crew.Count)
            })
            .OrderByDescending(x => x.Films)
            .ThenBy(x => x.Director)
            .Take(20)
            .ToList();
            foreach (var x in perDirector)
                Console.WriteLine($"{x.Director} — фильмов: {x.Films}, средний Cast: {x.AvgCast:F1}, средний Crew: {x.AvgCrew:F1}");
            Console.WriteLine();

            // 17. Универсалы: актёр и член съёмочной группы
            Printer.Section("Универсалы: самый частый департамент для людей, которые были и актёрами, и в съёмочной группе");
            var actorIds = movies.SelectMany(m => m.Cast.Select(c => c.Id)).ToHashSet();
            var crewEntries = movies.SelectMany(m => m.Crew).ToList();
            var crewByPerson = crewEntries.GroupBy(c => c.Id).ToDictionary(g => g.Key, g => g.ToList());
            var universals = actorIds.Intersect(crewByPerson.Keys).ToList();
            var universalRows = new List<string>();
            foreach (var pid in universals)
            {
                var dept = crewByPerson[pid].Where(c => !string.IsNullOrWhiteSpace(c.Department))
                                           .GroupBy(c => c.Department.Trim())
                                           .OrderByDescending(g => g.Count())
                                           .ThenBy(g => g.Key)
                                           .FirstOrDefault();
                if (dept != null)
                {
                    universalRows.Add($"{Helpers.NameOf(idToName, pid)} — топ-департамент: {dept.Key} (вхождений: {dept.Count()})");
                }
            }
            universalRows = universalRows.OrderBy(s => s).Take(50).ToList();
            Printer.DumpList(universalRows);

            // 18. Пересечение элитных клубов: Скорсезе и Нолан
            Printer.Section("Люди, работавшие и с Martin Scorsese, и с Christopher Nolan");
            var scorseseFilms = movies.Where(m => m.Crew.Any(c => Helpers.EqualsName(c.Name, "Martin Scorsese") && Helpers.EqualsJob(c.Job, "Director"))).ToList();
            var nolanFilms = movies.Where(m => m.Crew.Any(c => Helpers.EqualsName(c.Name, "Christopher Nolan") && Helpers.EqualsJob(c.Job, "Director"))).ToList();
            var scorsesePeople = scorseseFilms.SelectMany(m => m.Cast.Select(c => c.Id).Concat(m.Crew.Select(c => c.Id))).ToHashSet();
            var nolanPeople = nolanFilms.SelectMany(m => m.Cast.Select(c => c.Id).Concat(m.Crew.Select(c => c.Id))).ToHashSet();
            scorsesePeople.IntersectWith(nolanPeople);
            var bothNames = scorsesePeople.Select(id => Helpers.NameOf(idToName, id)).OrderBy(n => n).ToList();
            Printer.DumpList(bothNames);

            // 19. Скрытое влияние: департаменты vs размер Cast
            Printer.Section("Рейтинг департаментов по среднему размеру актёрского состава фильмов, где они задействованы");
            var deptToCastSizes = new Dictionary<string, List<int>>(StringComparer.OrdinalIgnoreCase);
            foreach (var m in movies)
            {
                var filmDepts = m.Crew.Select(c => c.Department).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim()).Distinct();
                foreach (var d in filmDepts)
                {
                    if (!deptToCastSizes.TryGetValue(d, out var list)) deptToCastSizes[d] = list = new List<int>();
                    list.Add(m.Cast.Count);
                }
            }
            var deptRank = deptToCastSizes.Select(kv => new { Dept = kv.Key, AvgCast = kv.Value.Average() })
                                          .OrderByDescending(x => x.AvgCast)
                                          .ToList();
            foreach (var x in deptRank) Console.WriteLine($"{x.Dept} — средний Cast: {x.AvgCast:F1}");
            Console.WriteLine();

            // 20. Архетипы персонажей Johnny Depp
            Printer.Section("Архетипы персонажей Johnny Depp (по первому слову роли)");
            var deppRoles = movies.SelectMany(m => m.Cast.Where(c => Helpers.EqualsName(c.Name, "Johnny Depp")))
                                  .Select(c => (c.Character ?? string.Empty).Trim())
                                  .Where(s => !string.IsNullOrWhiteSpace(s))
                                  .Select(Helpers.FirstWord)
                                  .Where(s => !string.IsNullOrWhiteSpace(s))
                                  .GroupBy(s => s)
                                  .Select(g => new { Archetype = g.Key, Cnt = g.Count() })
                                  .OrderByDescending(x => x.Cnt)
                                  .ThenBy(x => x.Archetype)
                                  .ToList();
            foreach (var a in deppRoles) Console.WriteLine($"{a.Archetype} — {a.Cnt}");
            Console.WriteLine();
        }
    }
}

