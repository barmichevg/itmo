using System;
using System.Collections.Generic;

namespace CSConsoleApp.Utils
{
    public static class Printer
    {
        public static void Section(string title)
        {
            Console.WriteLine(new string('=', Math.Max(8, title.Length)));
            Console.WriteLine(title);
            Console.WriteLine(new string('=', Math.Max(8, title.Length)) + "\n");
        }

        public static void DumpList(IEnumerable<string> items)
        {
            int count = 0;
            foreach (var s in items)
            {
                Console.WriteLine(s);
                count++;
            }
            Console.WriteLine($"\nВсего: {count}\n");
        }
    }
}

